# Give this server a friendly name.
DASHBOARD_NAME=Home Server

# Browser sign-in. Change the password before starting the container.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password

# Web port and time zone.
DASHBOARD_PORT=8080
TZ=UTC

# Internal container paths used by the supplied Compose files. Leave these at
# their defaults unless you also update the matching volume mount targets.
DATA_DIR=/data
HOST_VAR_LOG=/host/var/log

# Version shown by a locally built image. Published images set this during the
# GitHub build, so this value is only used by docker-compose.yml.
APP_VERSION=development

# Optional service checks separated by semicolons. Supported checks are exact
# process names, TCP ports, and HTTP(S) endpoints, for example:
# SERVICE_CHECKS=SSH=tcp:host.docker.internal:22;Nginx=process:nginx;Site=http:http://host.docker.internal/health
SERVICE_CHECKS=

# Optional alert delivery. Leave the URL empty to disable outbound alerts.
# Never commit a real webhook URL to Git.
ALERT_WEBHOOK_URL=
# Supported payloads: generic, discord, or slack.
ALERT_WEBHOOK_TYPE=generic
ALERT_COOLDOWN_MINUTES=30

# Repository checked by the dashboard for newer published versions.
GITHUB_REPOSITORY=IPandral/Computer-usage-dashboard

# Hide identifying host details when sharing screenshots or running a demo.
DEMO_MODE=false

# SMART is deliberately off until the container is granted raw-device access.
# SMART test schedules are configured in the dashboard and saved in /data.
SMART_ENABLED=false
SMARTCTL_PATH=smartctl
SMART_DEVICE_ROOT=/host/dev
# Numeric host `disk` group used only by the optional SMART Compose override.
# Check it on Ubuntu with: getent group disk
SMART_DISK_GID=6

# To pull a published GitHub Release, set this value in .env (replace OWNER
# and REPOSITORY first), then use docker-compose.release.yml:
# NODELIGHT_IMAGE=ghcr.io/OWNER/REPOSITORY:latest
