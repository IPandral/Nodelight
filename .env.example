# Give this server a friendly name.
DASHBOARD_NAME=Home Server

# Browser sign-in. Change the password before starting the container.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password

# Web port and time zone.
DASHBOARD_PORT=8080
TZ=UTC

# To pull a published GitHub Release, set this value in .env (replace OWNER
# and REPOSITORY first), then use docker-compose.release.yml:
# NODELIGHT_IMAGE=ghcr.io/OWNER/REPOSITORY:latest
